{
  "name": "build-spec-summary-voltara-is-a-self-con",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "build-spec-summary-voltara-is-a-self-con-db",
      "database_id": "PLACEHOLDER_DB_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
